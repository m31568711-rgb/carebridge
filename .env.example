# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — safe browser values only. Never expose the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Google Maps — restrict this key by domain and API in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-restricted-google-maps-key

# Future payment integration
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Future Web Push integration
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:security@example.com
