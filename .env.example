# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Supabase — safe browser values only. Never expose the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional browser-safe tile URL. Keep the {z}, {x}, and {y} placeholders.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional Google Maps address autocomplete/map picker. Restrict this browser key
# to your deployed origins and enable Maps JavaScript API + Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Future payment integration
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Future Web Push integration
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:security@example.com
